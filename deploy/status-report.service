# Modelo do serviço systemd. Não copie à mão: o install.sh preenche
# @USUARIO@, @PASTA@, @HOST@ e @PORTA@ e instala em /etc/systemd/system/.
[Unit]
Description=Status report one-page (Streamlit)
After=network.target

[Service]
User=@USUARIO@
WorkingDirectory=@PASTA@
ExecStart=@PASTA@/.venv/bin/streamlit run app.py --server.address @HOST@ --server.port @PORTA@ --server.headless true
Restart=on-failure
RestartSec=5
# HOME no /tmp privado: Streamlit, LibreOffice e fontconfig gravam caches ali.
Environment=HOME=/tmp

# Limites de recursos: um abuso derruba no máximo o app (que reinicia), não a VPS.
MemoryMax=1G
CPUQuota=80%
TasksMax=128

# Isolamento: o app só escreve na própria pasta e num /tmp privado.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PASTA@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
